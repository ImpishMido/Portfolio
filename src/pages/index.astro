---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { mainProjects, otherWorks } from '../projects.js';
---
<Base title="Lola Van Vooren - Video game programmer">
  <section class="hero">
    <h1>Lola Van Vooren</h1>
    <p class="lead">
      Video game programming student. Gameplay and tools programmer (Unreal Engine, C++, Unity, C#). I build editors and modular, data-driven systems so designers can add content without touching code.
    </p>
    <a class="status" href="#contact">Looking for an internship · Jan to Jun 2027</a>
    <a class="status" href="#contact">Belgium · Remote or relocation</a>
  </section>

  <section id="about">
    <h2>About me</h2>
    <p>
      I study Video Game Development at Haute Ecole Albert Jacquard in Namur, Belgium, with a
      specialisation in programming. I work both on solo projects and on team projects, and I am
      most comfortable with C++ (Unreal Engine) and C# (Unity), and I pick up new tools quickly.
      I also draw a lot!
    </p>
    <p>
      What I enjoy most is taking a problem the team keeps hitting and turning it into a tool that
      removes it for good. I'm looking forward to learning more about gameplay and tool programming.
    </p>
    <p>
      Based in Belgium, open to remote and relocation.
    </p>
    <p class="links">
      <a href="https://www.youtube.com/watch?v=pUEi6erpqp4" target="_blank">Demo Reel</a>
      <a href="/cv/lola-van-vooren-cv.pdf" target="_blank">Download my Resume (PDF)</a>
      <a href="https://impish-mido.itch.io/" target="_blank">itch.io</a>

    </p>

    </p>
  </section>

  <section id="tools">
    <h2>Skills</h2>
        <ul class="pills skills-legend" aria-label="Legend">
            <li class="pill is-strong">Confident</li>
            <li class="pill">Familiar</li>
        </ul>
    <div class="skills">
      <div class="skill-card">
        <h3>Engines</h3>
        <ul class="pills">
          <li class="pill is-strong">Unreal Engine</li>
          <li class="pill is-strong">Unity</li>
          <li class="pill">Godot</li>
        </ul>
        <p class="skill-note">Unreal with C++ on most of my projects. Data Tables, Data Assets, replication and Epic Online Services</p>
      </div>
      <div class="skill-card">
        <h3>Programming</h3>
        <ul class="pills">
          <li class="pill is-strong">C++</li>
          <li class="pill is-strong">C#</li>
          <li class="pill is-strong">Blueprint</li>
          <li class="pill">Java</li>
        </ul>
        <p class="skill-note">Gameplay systems, editor tools, and online replication.</p>
      </div>
      <div class="skill-card">
        <h3>Tools</h3>
        <ul class="pills">
          <li class="pill is-strong">VS Code</li>
          <li class="pill is-strong">Visual Studio</li>
          <li class="pill is-strong">Clip Studio Paint</li>
          <li class="pill">GitHub</li>
        </ul>
      </div>
      <div class="skill-card">
        <h3>Languages</h3>
        <ul class="pills">
          <li class="pill is-strong">French</li>
          <li class="pill is-strong">English</li>
          <li class="pill">Dutch</li>
        </ul>
        <p class="skill-note">English learned on my own, used daily.</p>
      </div>
    </div>
  </section>

  <section id="problem-solving">
    <div class="teaser">
      <h3>One problem I solved</h3>
      <p>
        In my roguelike, every level is built on a grid. I used to type in the level data by hand
        index by index. As it was long and tedious I built a grid editor inside the project: I draw the grid, I preview it,
        and the tool generates the code the game reads back. Anyone can now build levels without
        knowing how the generation even works.
      </p>
      <p class="links">
        <a href="/projects/roguelike-tower-defense/">See how it works, with the code</a>
      </p>
    </div>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="cards">
      {mainProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="other">
    <h2>Other works</h2>
    <p class="muted">Work outside gameplay programming and video game making.</p>
    <div class="cards">
      {otherWorks.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="contact">
    <ContactCTA />
  </section>
</Base>
